APP_NAME=MuruDPipeline API
ENVIRONMENT=development
CORS_ORIGINS=*
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
SUPABASE_URL=
SUPABASE_KEY=
# Required only for tool secrets. Never expose to the frontend.
SUPABASE_SERVICE_KEY=
DBOS_DATABASE_URL=

# Frontend URL Supabase returns the browser to after Google sign-in.
# Must also be allowlisted in Supabase > Authentication > URL Configuration.
# Required for Google sign-in; leave blank if unused.
OAUTH_REDIRECT_URL=

# Google Cloud OAuth client id, for tool node connect flows (Gmail etc).
GOOGLE_OAUTH_CLIENT_ID=
# Google Cloud OAuth client secret. Never expose to the frontend.
GOOGLE_OAUTH_CLIENT_SECRET=
# Random secret signing the oauth connect flow's state param.
OAUTH_STATE_SECRET=
# Frontend origin, to redirect the browser back after the oauth callback.
FRONTEND_URL=

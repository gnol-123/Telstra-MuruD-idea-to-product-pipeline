APP_NAME=MuruDPipeline API
ENVIRONMENT=development
CORS_ORIGINS=*
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
SUPABASE_URL=
SUPABASE_KEY=

# Frontend URL Supabase returns the browser to after Google sign-in.
# Tokens arrive in the URL fragment (#access_token=...), which only browser
# JavaScript can read, so this must be a frontend route, not an API route.
# Must also be allowlisted in Supabase > Authentication > URL Configuration.
# Required for Google sign-in; leave blank if unused.
OAUTH_REDIRECT_URL=

APP_NAME=MuruDPipeline API
ENVIRONMENT=development
CORS_ORIGINS=*
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
SUPABASE_URL=
SUPABASE_KEY=
# Required only for tool secrets. Never expose to the frontend.
SUPABASE_SERVICE_KEY=
DBOS_DATABASE_URL=

# Frontend URL Supabase returns the browser to after Google sign-in.
# Must also be allowlisted in Supabase > Authentication > URL Configuration.
# Required for Google sign-in; leave blank if unused.
OAUTH_REDIRECT_URL=
